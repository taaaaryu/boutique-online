FROM locustio/locust:2.25.0

# Ensure plotting works headless and install dependencies
ENV MPLBACKEND=Agg

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Ensure venv python/pip are first in PATH and install Python packages
ENV PATH="/opt/venv/bin:${PATH}"
RUN /opt/venv/bin/pip install --no-cache-dir pandas matplotlib requests

# Also install packages into the system python3 environment used by 'python3'
RUN python3 -m pip install --no-cache-dir pandas matplotlib requests || true

# Install kubectl for in-cluster operations
ARG KUBECTL_VERSION=v1.32.0
RUN curl -fsSL -o /usr/local/bin/kubectl https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && kubectl version --client=true

WORKDIR /app

# Copy test scripts
COPY each_test/ /app/each_test/

RUN chmod +x /app/each_test/run_tests.sh

# Default command runs the test suite
ENTRYPOINT ["/bin/bash","-lc"]
CMD ["cd /app/each_test && ./run_tests.sh"]


